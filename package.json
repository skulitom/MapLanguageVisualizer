{
  "name": "world-language-map",
  "private": true,
  "version": "1.0.0",
  "description": "Interactive world map of official and major languages by country: highlight languages, compare language families, share the view.",
  "keywords": [
    "language-map",
    "world-map",
    "languages",
    "linguistics",
    "language-families",
    "official-languages",
    "data-visualization",
    "d3",
    "react"
  ],
  "homepage": "https://skulitom.github.io/MapLanguageVisualizer/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skulitom/MapLanguageVisualizer.git"
  },
  "bugs": "https://github.com/skulitom/MapLanguageVisualizer/issues",
  "license": "MIT",
  "author": "Artem Skulimovskiy",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "data": "tsx scripts/prepare-language-data.ts && tsx scripts/prepare-country-points.ts"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.1.0",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.8",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
